# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings. The generated data must be byte-identical on every OS,
# and Pelican runs on Linux.
*.php       text eol=lf
*.blade.php text eol=lf
*.svg       text eol=lf
*.json      text eol=lf
*.ts        text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.neon      text eol=lf
bun.lock    text eol=lf
LICENSE     text eol=lf

# Generated files (written by `bun run build` / `bun run fetch:vscode`)
resources/icons/**                linguist-generated
resources/data/**                 linguist-generated -diff
scripts/data/vscode-languages.json linguist-generated

# Development-only files, left out of `git archive` and GitHub source downloads
/.github           export-ignore
/scripts           export-ignore
/tests             export-ignore
/.gitattributes    export-ignore
/.gitignore        export-ignore
/bun.lock          export-ignore
/package.json      export-ignore
/phpstan.neon      export-ignore
/pint.json         export-ignore
/tsconfig.json     export-ignore
